{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["runtime/**/*.ts", "experiments/**/*.ts", "examples/**/*.ts", "test/**/*.ts"]
}
